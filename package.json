{
  "name": "herdr-llm-summary-header",
  "version": "0.1.0",
  "private": true,
  "description": "Herdr plugin that writes an LLM-generated one-line summary to a pane's title when an agent finishes",
  "main": "summarize.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "smoke:build": "docker build -t herdr-summary-header-smoke -f smoke/Dockerfile .",
    "smoke:run": "docker run --rm -v ~/.claude.json:/creds-ro/claude.json:ro -v ~/.claude:/creds-ro/claude:ro -v ~/.codex:/creds-ro/codex:ro herdr-summary-header-smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2"
  }
}
